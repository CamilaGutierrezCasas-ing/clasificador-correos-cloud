APP_NAME=Clasificador Correos Microsoft
APP_ENV=production
APP_DEBUG=false
API_V1_STR=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Usa la URL real de PostgreSQL que entregue Render/Railway/Neon/Supabase.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME

# Solo dominios permitidos del frontend, separados por coma.
CORS_ORIGINS=https://TU-FRONTEND.vercel.app,http://localhost:3000,http://localhost:5173

# Genera una clave larga y privada. No uses esta de ejemplo.
JWT_SECRET_KEY=cambia-esto-por-una-clave-segura-de-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DEFAULT_ADMIN_NAME=Administrador
DEFAULT_ADMIN_EMAIL=admin@tudominio.com
DEFAULT_ADMIN_PASSWORD=cambia-esta-clave

MICROSOFT_CLIENT_ID=tu-client-id
MICROSOFT_CLIENT_SECRET=tu-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://TU-BACKEND.onrender.com/api/v1/microsoft/callback
MICROSOFT_SCOPES=openid profile offline_access User.Read Mail.Read
FRONTEND_CALLBACK_URL=https://TU-FRONTEND.vercel.app/microsoft/callback
